# Área 02. Copiar a .env.local, que NO se sube al repo. La clave se saca gratis en https://aistudio.google.com (Get API key).
VITE_GEMINI_API_KEY=
# Uno o varios modelos separados por coma, en orden de preferencia. Si el primero falla (503, 404...), se prueba el siguiente;
# los modelos de respaldo por defecto se agregan al final (ver MODELOS_POR_DEFECTO en moderador.js).
VITE_GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash
